# 管理端令牌：必填，至少 16 个字符，禁止弱口令。
# 生成：openssl rand -hex 32
ADMIN_TOKEN=

# 监听配置
LISTEN_ADDRESS=0.0.0.0
LISTEN_PORT=8080

# 存储与静态资源
DB_PATH=/data/feedback.db
STATIC_DIR=/app/static
MIGRATIONS_DIR=/app/migrations

# 请求体上限（字节），默认 65536
MAX_BODY_BYTES=65536

# 提交限流：每个 IP 哈希在窗口内的最大提交次数
SUBMIT_RATE_MAX=10
SUBMIT_RATE_WINDOW_SECONDS=3600

# 管理端限流
ADMIN_RATE_MAX=600
ADMIN_RATE_WINDOW_SECONDS=3600

# 限流盐：留空则每次启动随机生成，仅驻留内存
RATE_LIMIT_SALT=

# 日志：error | warn | info | debug；输出 stderr 或 syslog
LOG_LEVEL=info
LOG_TARGET=stderr
LOG_IDENT=anonfeedback

# HTTP 服务并发
THREAD_POOL_SIZE=4
CONNECTION_LIMIT=128
